# Copy to .env and fill in before running `docker compose up -d`.

# Required. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_TOKEN_SECRET=

# Optional: creates the first admin account on startup when data/users.json is empty.
# Remove the password from .env after the first start. Put values that contain "$"
# in single quotes (ADMIN_PASSWORD='Pa$$word'), otherwise Compose rewrites them.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional
# Organisation name for the title bar and AGS4 exports, e.g. ORG_NAME="PT Geoteknik Nusantara"
# ORG_NAME=
# Time zone for "today", report timestamps and the last-7/30-days views
# APP_TIMEZONE=Asia/Jakarta
# AUTH_TOKEN_TTL=28800
# HTTP_PORT=80
# OLLAMA_URL=http://host.docker.internal:11434/api/chat
# OLLAMA_MODEL=gpt-oss:120b-cloud
# OLLAMA_API_KEY=
