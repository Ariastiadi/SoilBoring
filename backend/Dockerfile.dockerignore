# Dockerfile-specific ignore file (the build context is the repo root, so a plain
# backend/.dockerignore would be ignored by Docker). Paths are relative to the repo root.
**/__pycache__/
**/*.pyc
.venv/
venv/
.git/
.github/
.gitignore
**/*.log
**/*.tmp
**/.pytest_cache/

# Not needed in the backend image
frontend/
archive/
docs/
scripts/

# Data lives in a bind-mounted volume, never inside the image
data/
backend/tests/
.env
